<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 backup (data_extraction_rules covers 12+). Keystore-encrypted prefs can't decrypt on a new device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
    <exclude domain="file" path="datastore/clibeats_prefs.preferences_pb" />
</full-backup-content>
