<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 backup (data_extraction_rules covers 12+). The database, DataStore and playback
     history are backed up together so a restore doesn't reopen onboarding over a full library.
     The Keystore-encrypted prefs file is excluded: it cannot be decrypted on a new device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
    <exclude domain="database" path="clibeats.db" />
    <exclude domain="database" path="clibeats.db-wal" />
    <exclude domain="database" path="clibeats.db-shm" />
</full-backup-content>
