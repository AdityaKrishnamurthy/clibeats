<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8-11 backup (data_extraction_rules covers 12+). DataStore preferences and manual
     snapshots stay eligible, while the Room database files (unencrypted local history/library),
     downloaded audio files, and legacy Keystore-encrypted prefs are excluded. -->
<full-backup-content>
    <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
    <exclude domain="database" path="clibeats.db" />
    <exclude domain="database" path="clibeats.db-wal" />
    <exclude domain="database" path="clibeats.db-shm" />
    <exclude domain="file" path="downloads" />
</full-backup-content>
