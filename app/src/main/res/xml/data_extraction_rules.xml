<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer. Excludes Room database files, downloaded
     audio files, and legacy Keystore-encrypted shared preferences from automatic cloud backup
     and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
        <exclude domain="database" path="clibeats.db" />
        <exclude domain="database" path="clibeats.db-wal" />
        <exclude domain="database" path="clibeats.db-shm" />
        <exclude domain="file" path="downloads" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
        <exclude domain="database" path="clibeats.db" />
        <exclude domain="database" path="clibeats.db-wal" />
        <exclude domain="database" path="clibeats.db-shm" />
        <exclude domain="file" path="downloads" />
    </device-transfer>
</data-extraction-rules>
