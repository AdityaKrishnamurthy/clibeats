<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device transfer.
     The Room database, the DataStore preferences and the playback history are included on purpose,
     so a restore brings back the whole library and the onboarding flag together. Only the
     Keystore-encrypted file is excluded: its key never leaves the old device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="clibeats_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
