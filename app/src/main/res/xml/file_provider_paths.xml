<?xml version="1.0" encoding="utf-8"?>
<!--
    Paths exposed by androidx.core.content.FileProvider for the in-app updater.
    The downloaded APK is placed in filesDir/updates/ and shared with the system installer
    via a content:// URI instead of a plain file:// URI (required for Android 7+).
-->
<paths>
    <files-path
        name="update_apks"
        path="updates/" />
</paths>
